#include 'actions/device'
#include 'actions/text'
#include 'actions/documents'
#include 'actions/settings'
#define name Tile Windows
#define color blue
#define glyph twoxTwoRectangles

// Tile Windows for iPad — port of laurensanp/tile-windows.
// Tiles the visible app windows, sized by how much you use each app (ranking below).

// ===== Settings =====
// Your apps, most important first. Higher up = placed first / gets the big slot.
@ranking = "Freenotes\nTikTok\nClaude\nSafari\nVorschau\nChess\nWhatsApp\nYouTube\nTwitch\nWörterbuch Linguee\nDateien\nWord\nGitHub\nSchulmanager\nInstagram\nGoodnotes\nClassic\nDiscord\nFotos\nRechner\nEinstellungen\nKurzbefehle\nApp Store\nKalender\nSpotify\nGoogle Drive - Dateispeicher\nDeepSeek\nPowerPoint\nCornelsen Lernen\nNachrichten\nReddit"
// Apps that need width (websites, videos, documents): never squeezed into a narrow third (like WideApps).
@needsWidth = "Safari\nYouTube\nTwitch\nVorschau\nWord\nPowerPoint\nGoodnotes\nFreenotes\nGitHub"
// Never tiled (games, overlays). If you're in one when you run this, you stay in it.
@ignore = "Minecraft\nRoblox\nGenshin Impact"
// Stage Manager opens every app in its own stage, so tiling happens in Windowed Apps mode.
// "yes" = switch back to Stage Manager afterwards, "no" = stay in Windowed Apps.
@backToStageManager = "yes"
// ====================

@front = getCurrentApp()
@frontName = getName(@front)
@visible = getVisibleApps()
@mode = getMultitaskingMode()
@modeText = "{@mode}"
@wasStage = "no"
if @modeText contains "Stage" {
    @wasStage = "yes"
    setWindowedMultitasking()
}

@rankLines = splitText(@ranking, "\n")
@rankWrapped = "\n{@ranking}\n"
@ignoreWrapped = "\n{@ignore}\n"
@wideWrapped = "\n{@needsWidth}\n"

// Sort the visible apps by your ranking and give each a weight tier (like Weights in settings.json):
// places 1-4 = "3" (big), 5-12 = "2" (medium), lower or not listed = "1" (small).
@ordered = []
@tiers = []
for rankName in @rankLines {
    @rankPos = RepeatIndex
    @wanted = "{rankName}"
    @tier = "1"
    if @rankPos <= 12 { @tier = "2" }
    if @rankPos <= 4 { @tier = "3" }
    for vis in @visible {
        @visName = getName(vis)
        if @visName == @wanted {
            @ordered += vis
            @tiers += @tier
        }
    }
}
@newApps = ""
for vis2 in @visible {
    @n2 = getName(vis2)
    @probe = "\n{@n2}\n"
    if @rankWrapped !contains @probe {
        if @ignoreWrapped !contains @probe {
            @ordered += vis2
            @tiers += "1"
            @newApps = "{@newApps}{@n2}, "
        }
    }
}
if @newApps != "" {
    showNotification("Not in your list yet: {@newApps}add them to the list at the top of Tile Windows.", "Tile Windows: new apps")
}

@count = count(@ordered)
if @count == 0 {
    stop()
}
// At most 4 windows stay readable; the least important ones are left as they are.
if @count > 4 {
    @count = 4
}

// Tiers are sorted high to low, so "different" means the first app is more important.
@tier1 = getListItem(@tiers, 1)
@t1 = "{@tier1}"
@t2 = ""
if @count >= 2 {
    @tier2 = getListItem(@tiers, 2)
    @t2 = "{@tier2}"
}

// Two apps of different weight: the important one gets 2/3 (Split Screen), done.
if @count == 2 {
    if @t1 != @t2 {
        @bigApp = getListItem(@ordered, 1)
        @smallApp = getListItem(@ordered, 2)
        rawAction("is.workflow.actions.splitscreen", {
            "WFPrimaryAppIdentifier": @smallApp,
            "WFSecondaryAppIdentifier": @bigApp,
            "WFAppRatio": "⅓ + ⅔"
        })
        if @wasStage == "yes" {
            if @backToStageManager == "yes" {
                setStageManagerMultitasking()
            }
        }
        stop()
    }
}

// Three apps: the most important gets a half and the other two stack beside it,
// unless all three weigh about the same, then equal thirds.
// An app that needs width never gets a narrow third; it takes the half instead.
@kind = "{@count}"
@final = []
if @count == 3 {
    @wideApp = ""
    for cand in @ordered {
        if RepeatIndex <= 3 {
            @candName = getName(cand)
            if @wideWrapped contains "\n{@candName}\n" {
                if @wideApp == "" {
                    @wideApp = @candName
                }
            }
        }
    }
    @halfApp = ""
    if @t1 != @t2 {
        @firstApp = getListItem(@ordered, 1)
        @halfApp = getName(@firstApp)
    } else {
        if @wideApp != "" { @halfApp = @wideApp }
    }
    if @halfApp == "" {
        @kind = "3t"
        @final = @ordered
    } else {
        @kind = "3h"
        for w in @ordered {
            @wName = getName(w)
            if @wName == @halfApp {
                @final += w
            }
        }
        for o in @ordered {
            @oName = getName(o)
            if @oName != @halfApp {
                @final += o
            }
        }
    }
} else {
    @final = @ordered
}

// Number of good layouts for this case.
@layouts = 1
if @kind == "2" { @layouts = 2 }
if @kind == "3t" { @layouts = 3 }
if @kind == "3h" { @layouts = 2 }
if @kind == "4" { @layouts = 2 }

// Each run picks another good layout, never the one shown last.
@lastFile = rawAction("is.workflow.actions.documentpicker.open", {
    "WFGetFilePath": "tile-windows-last.txt",
    "WFFileErrorIfNotFound": false,
    "WFShowFilePicker": false
})
@lastText = trimWhitespace("{@lastFile}")
@variant = 0
if @layouts > 1 {
    @variant = randomNumber(0, @layouts - 1)
    @variantText = "{@kind}-{@variant}"
    if @variantText == @lastText {
        @variant = @variant + 1
        if @variant >= @layouts { @variant = 0 }
    }
}
@key = "{@kind}-{@variant}"
@saveText = text("{@key}")
saveFile("tile-windows-last.txt", @saveText, true)

// Slots in order: first = most important app (or the app that needs width).
@slotTable = {
    "1-0": "Full Screen",
    "2-0": "Left,Right",
    "2-1": "Right,Left",
    "3t-0": "Left Third,Middle Third,Right Third",
    "3t-1": "Middle Third,Left Third,Right Third",
    "3t-2": "Right Third,Middle Third,Left Third",
    "3h-0": "Left,Top Trailing,Bottom Trailing",
    "3h-1": "Right,Top Leading,Bottom Leading",
    "4-0": "Top Leading,Top Trailing,Bottom Leading,Bottom Trailing",
    "4-1": "Top Trailing,Top Leading,Bottom Trailing,Bottom Leading"
}
@slotText = getValue(@slotTable, @key)
@slots = splitText("{@slotText}", ",")

// Place every window; the app you ran it from is placed last so it keeps focus.
@frontSlot = ""
for app in @final {
    if RepeatIndex <= @count {
        @thisApp = app
        @thisName = getName(@thisApp)
        @thisSlot = getListItem(@slots, RepeatIndex)
        if @thisName == @frontName {
            @frontSlot = "{@thisSlot}"
        } else {
            rawAction("is.workflow.actions.openapp", {
                "WFSelectedApp": @thisApp,
                "WFWindowingFormat": @thisSlot
            })
        }
    }
}
if @frontSlot != "" {
    rawAction("is.workflow.actions.openapp", {
        "WFSelectedApp": @front,
        "WFWindowingFormat": @frontSlot
    })
} else {
    rawAction("is.workflow.actions.openapp", {
        "WFSelectedApp": @front
    })
}

if @wasStage == "yes" {
    if @backToStageManager == "yes" {
        setStageManagerMultitasking()
    }
}
